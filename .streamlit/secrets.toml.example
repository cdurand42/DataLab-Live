# DataLab-Live — Template des Secrets Streamlit (Community Cloud ou Local)
# Pour une utilisation locale : copier dans .streamlit/secrets.toml
# NE JAMAIS COMMITER DE VALEURS RÉELLES DANS GIT.

# 1. Identifiant requis pour le sas d'accès
LIVE_USERNAME = "admin"

# 2. Hash salé PBKDF2-HMAC-SHA256 du mot de passe (aucun mot de passe en clair accepté)
# Format : pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
#
# Pour générer votre hash sous terminal sans écrire le mot de passe dans l'historique :
#   python auth.py
#
# Ou en une seule ligne Python :
#   python -c "import hashlib, secrets; s = secrets.token_bytes(16); it = 600000; p = input('Password: '); dk = hashlib.pbkdf2_hmac('sha256', p.encode(), s, it).hex(); print(f'pbkdf2_sha256${it}${s.hex()}${dk}')"
#
LIVE_PASSWORD_HASH = "pbkdf2_sha256$600000$replace_with_salt_hex$replace_with_dk_hex"

# 3. URL HTTPS du backend privé DataLab-Enedis (ex: Railway, Render ou instance privée)
DATALAB_API_URL = "https://votre-datalab-api.up.railway.app"

# 4. Jeton secret partagé avec le backend privé (transmis dans l'en-tête X-DataLab-Token côté serveur)
DATALAB_API_TOKEN = "votre_token_secret_partage"
